{
  "name": "testcontainers-adapters-demo",
  "version": "0.1.0",
  "private": true,
  "description": "Integration testing interchangeable PostgreSQL and OpenSearch adapters with Testcontainers",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:postgres": "vitest run test/integration/postgres/",
    "test:opensearch": "vitest run test/integration/opensearch/",
    "test:ui": "vitest --ui --watch",
    "test:ui:postgres": "vitest --ui --watch test/integration/postgres/",
    "test:ui:opensearch": "vitest --ui --watch test/integration/opensearch/",
    "test:colima": "DOCKER_HOST=unix://\"$HOME\"/.colima/default/docker.sock TESTCONTAINERS_DOCKER_SOCKET_OVERRIDE=/var/run/docker.sock npm test --",
    "test:colima:postgres": "DOCKER_HOST=unix://\"$HOME\"/.colima/default/docker.sock TESTCONTAINERS_DOCKER_SOCKET_OVERRIDE=/var/run/docker.sock npm run test:postgres --",
    "test:colima:opensearch": "DOCKER_HOST=unix://\"$HOME\"/.colima/default/docker.sock TESTCONTAINERS_DOCKER_SOCKET_OVERRIDE=/var/run/docker.sock npm run test:opensearch --",
    "test:colima:ui": "DOCKER_HOST=unix://\"$HOME\"/.colima/default/docker.sock TESTCONTAINERS_DOCKER_SOCKET_OVERRIDE=/var/run/docker.sock npm run test:ui --",
    "test:colima:ui:postgres": "DOCKER_HOST=unix://\"$HOME\"/.colima/default/docker.sock TESTCONTAINERS_DOCKER_SOCKET_OVERRIDE=/var/run/docker.sock npm run test:ui:postgres --",
    "test:colima:ui:opensearch": "DOCKER_HOST=unix://\"$HOME\"/.colima/default/docker.sock TESTCONTAINERS_DOCKER_SOCKET_OVERRIDE=/var/run/docker.sock npm run test:ui:opensearch --"
  },
  "dependencies": {
    "@mikro-orm/core": "^7.2.5",
    "@mikro-orm/postgresql": "^7.2.5",
    "@opensearch-project/opensearch": "^3.9.0"
  },
  "devDependencies": {
    "@testcontainers/opensearch": "^12.2.1",
    "@testcontainers/postgresql": "^12.2.1",
    "@types/node": "^24.19.2",
    "@vitest/ui": "^5.0.5",
    "testcontainers": "^12.2.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
